{
  "permissions": {
    "allow": [
      "Edit(src/**)",
      "Edit(tests/**)",
      "Bash(uv run pytest*)",
      "Bash(SDL_VIDEODRIVER=dummy uv run tankgame --simulate*)",
      "Bash(uv run tankgame --simulate*)",
      "Bash(uv sync)",
      "Bash(uv run ruff*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "ask": [
      "Edit(pyproject.toml)",
      "Edit(uv.lock)",
      "Edit(.claude/**)",
      "Bash(uv add*)",
      "Bash(uv remove*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git merge*)"
    ],
    "deny": [
      "Edit(~/.local/share/tankgame/**)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 180,
            "statusMessage": "Running ruff, tests and smoke test..."
          }
        ]
      }
    ]
  }
}
